# Скопируй этот файл в .env и заполни своими значениями

# Секретный ключ для JWT. Сгенерировать:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Приложение не запустится, пока здесь стоит значение-заглушка.
SECRET_KEY=change-this-secret-key-before-deploying

# URL базы данных (SQLite по умолчанию)
# Для PostgreSQL: postgresql://user:password@localhost/dbname
DATABASE_URL=sqlite:///./sto.db

# Время жизни токена в минутах (480 = 8 часов)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Адрес и порт сервера
HOST=0.0.0.0
PORT=8000

# Внешний адрес CRM для ссылок клиентам (без слэша на конце)
# Если открываете CRM по IP или localhost, укажите здесь реальный домен/адрес, доступный клиентам:
# PUBLIC_URL=https://crm.divera.kz

# Пароль первого владельца (логин owner). Используется только при первом запуске
# на пустой базе. Если не задан — пароль будет сгенерирован и выведен в консоль.
INITIAL_OWNER_PASSWORD=

# Домены, которым разрешено обращаться к API с другого адреса (через запятую).
# Обычно не нужно: фронтенд отдаётся этим же сервером.
# ALLOWED_ORIGINS=https://crm.example.ru

# Автоперезагрузка при изменении кода — только для разработки
DEBUG=false

# --- Будущее: GreenAPI (WhatsApp уведомления) ---
# GREENAPI_INSTANCE_ID=your_instance_id
# GREENAPI_API_TOKEN=your_api_token
